@*
    App: PrintHost must be a direct child of #app (PDF export / printing).
    AuthorizeRouteView sends signed-out users to the login page.
*@
<PrintHost />
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <ErrorView Code="403" />
                }
            </NotAuthorized>
            <Authorizing>
                <LoadingState Text="@L["App.CheckingAccess"]" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
