@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@* S01 Dashboard: cluster summary, queue usage against thresholds, latest anomalies; manual or user-chosen auto refresh (Q8). *@
<PageTitle>@L["Menu.Dashboard"]</PageTitle>

<RequirePermission Permission="@AppPermissions.DashboardView">
    <PageHeader Title="@L["Menu.Dashboard"]" Description="@L["Dashboard.Description"]">
        <Actions>
            <div class="toolbar-inline">
                <label for="refresh-interval" class="muted">@L["Dashboard.AutoRefresh"]</label>
                <DxComboBox InputId="refresh-interval" Data="RefreshOptions" Value="_refreshSeconds" ValueChanged="(int v) => ChangeIntervalAsync(v)"
                            ValueFieldName="@nameof(ListOption<int>.Value)" TextFieldName="@nameof(ListOption<int>.Text)" Width="140px" />
                <AppButton Text="@L["Common.Refresh"]" Icon="refresh" Busy="_loading" OnClick="LoadAsync" />
            </div>
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <Alert Level="AlertLevel.Danger" Title="@L["Common.LoadFailed"]">
            <ChildContent>@_error</ChildContent>
            <Actions><AppButton Text="@T["Common.Retry"]" Icon="refresh" Size="ButtonSize.Small" OnClick="LoadAsync" /></Actions>
        </Alert>
    }

    @if (_summary is null)
    {
        @if (_error is null) { <LoadingState /> }
    }
    else
    {
        <div class="page-stack">
            <div class="stats" role="list">
                <StatCard Label="@L["Dashboard.WorkersOnline"]" Value="@_summary.WorkersOnline.ToString("N0")" Icon="monitor" Href="workers" />
                <StatCard Label="@L["Dashboard.WorkersDraining"]" Value="@_summary.WorkersDraining.ToString("N0")" Icon="pause" Href="workers" />
                <StatCard Label="@L["Dashboard.WorkersOffline"]" Value="@_summary.WorkersOffline.ToString("N0")" Icon="wifi-off" Href="workers" />
                <StatCard Label="@L["Dashboard.Capacity"]" Value="@_summary.TotalCapacity.ToString("N0")" Icon="layout" />
                <StatCard Label="@L["Dashboard.ActiveJobs"]" Value="@_summary.ActiveJobs.ToString("N0")" Icon="play" Href="jobs?status=Running" />
                <StatCard Label="@L["Dashboard.PendingJobs"]" Value="@_summary.PendingByType.Values.Sum().ToString("N0")" Icon="hourglass" Href="jobs?status=Pending" />
            </div>

            <div class="two-col">
                <Card Title="@L["Dashboard.JobsByStatus"]">
                    <AppGrid TItem="CountRow" Items="_statusRows" KeyFieldName="@nameof(CountRow.Key)" Caption="@L["Dashboard.JobsByStatus"]" ShowSearchBox="false" ShowGroupPanel="false">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(CountRow.Text)" Caption="@L["Job.Status"]">
                                <CellDisplayTemplate><JobStatusBadge Status="@(((CountRow)context.DataItem).Status!.Value)" /></CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(CountRow.Count)" Caption="@L["Common.Count"]" DisplayFormat="N0" Width="120px" />
                        </Columns>
                    </AppGrid>
                </Card>
                <Card Title="@L["Dashboard.PendingByType"]">
                    @if (_summary.PendingByType.Count == 0)
                    {
                        <EmptyState Title="@L["Dashboard.NoPending"]" Icon="check-circle" />
                    }
                    else
                    {
                        <AppGrid TItem="CountRow" Items="_pendingRows" KeyFieldName="@nameof(CountRow.Key)" Caption="@L["Dashboard.PendingByType"]" ShowSearchBox="false" ShowGroupPanel="false">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(CountRow.Text)" Caption="@L["Job.JobType"]" />
                                <DxGridDataColumn FieldName="@nameof(CountRow.Count)" Caption="@L["Common.Count"]" DisplayFormat="N0" Width="120px" />
                            </Columns>
                        </AppGrid>
                    }
                </Card>
            </div>

            <div class="two-col">
                <Card Title="@L["Dashboard.QueueUsage"]" Description="@L["Dashboard.QueueUsageHint"]">
                    @if (_queues is not { Count: > 0 })
                    {
                        <EmptyState Title="@L["Dashboard.NoThresholds"]" Icon="hourglass">
                            <AppButton Text="@L["Threshold.New"]" Icon="plus" Permission="@AppPermissions.QueueManage" Href="alerts/queue-thresholds/new" />
                        </EmptyState>
                    }
                    else
                    {
                        <div class="page-stack">
                            @foreach (var q in _queues.Where(q => q.Enabled))
                            {
                                <UsageBar Label="@(q.JobType == "*" ? L["Threshold.AllTypes"].Value : q.JobType)" Percent="q.UsagePercent" Pending="q.Pending" Max="q.MaxPending" Level="q.Level" />
                            }
                        </div>
                    }
                </Card>
                <Card Title="@L["Dashboard.Leader"]">
                    <FieldGrid Columns="1">
                        <FactField Label="@L["Dashboard.LeaderInstance"]" Value="@(_summary.LeaderInstance ?? L["Dashboard.NoLeader"].Value)" />
                        <FactField Label="@L["Dashboard.ThisInstance"]" Value="@(_summary.ThisInstanceIsLeader ? L["Common.Yes"].Value : L["Common.No"].Value)" />
                        <FactField Label="@L["Dashboard.GeneratedAt"]" Value="@Fmt.Time(_summary.GeneratedUtc)" />
                    </FieldGrid>
                </Card>
            </div>

            <PermissionView Permission="@AppPermissions.InsightView">
                <Card Title="@L["Dashboard.RecentAnomalies"]">
                    <HeaderActions><AppButton Text="@L["Common.ViewAll"]" Icon="chevron-right" Href="insights/anomalies" Size="ButtonSize.Small" /></HeaderActions>
                    <ChildContent>
                        @if (_anomalies is not { Count: > 0 })
                        {
                            <EmptyState Title="@L["Anomaly.None"]" Icon="check-circle" />
                        }
                        else
                        {
                            <AppGrid TItem="AnomalyRow" Items="_anomalies" KeyFieldName="@nameof(AnomalyRow.Index)" Caption="@L["Dashboard.RecentAnomalies"]" ShowSearchBox="false" ShowGroupPanel="false">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(AnomalyRow.SeverityText)" Caption="@L["Anomaly.Severity"]" Width="130px">
                                        <CellDisplayTemplate>
                                            @{ var a = ((AnomalyRow)context.DataItem).Anomaly; }
                                            <Badge Text="@Fmt.Severity(a.Severity)" Level="@Fmt.SeverityLevel(a.Severity)" Icon="alert-triangle" />
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnomalyRow.KindText)" Caption="@L["Anomaly.Kind"]" Width="170px" />
                                    <DxGridDataColumn FieldName="@nameof(AnomalyRow.Subject)" Caption="@L["Anomaly.Subject"]" Width="170px" />
                                    <DxGridDataColumn FieldName="@nameof(AnomalyRow.Description)" Caption="@L["Anomaly.Description"]" MinWidth="200" />
                                    <DxGridDataColumn FieldName="@nameof(AnomalyRow.Detected)" Caption="@L["Anomaly.DetectedAt"]" DisplayFormat="dd/MM/yyyy HH:mm:ss" Width="160px" />
                                </Columns>
                            </AppGrid>
                        }
                    </ChildContent>
                </Card>
            </PermissionView>
        </div>
    }
</RequirePermission>

@code {
    [Inject] private JobDistApi Api { get; set; } = default!;
    [Inject] private PermissionService Permissions { get; set; } = default!;
    [Inject] private DashboardSettings Settings { get; set; } = default!;
    [Inject] private StatusService Status { get; set; } = default!;

    private static readonly IReadOnlyList<ListOption<int>> RefreshOptions =
        DashboardSettings.Choices.Select(s => new ListOption<int>(s, s == 0 ? AppText.Get("Dashboard.RefreshOff") : AppText.Format("Dashboard.RefreshEvery", s))).ToList();

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private ClusterSummary? _summary;
    private List<QueueStatusResponse>? _queues;
    private List<AnomalyRow>? _anomalies;
    private int _refreshSeconds;

    private IReadOnlyList<CountRow> _statusRows = [];
    private IReadOnlyList<CountRow> _pendingRows = [];
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _refreshSeconds = await Settings.GetAsync();
        await LoadAsync();
        StartTimer();
    }

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        try
        {
            // Summary is required; queue status and anomalies are best effort (they need other permissions / roles).
            var summary = Api.GetSummaryAsync(_cts.Token);
            var queues = TryAsync(() => Api.GetQueueStatusAsync(_cts.Token));
            var anomalies = await Permissions.HasPermissionAsync(AppPermissions.InsightView)
                ? TryAsync(async () => (await Api.GetAnomaliesAsync(15, _cts.Token)).Anomalies.OrderByDescending(a => a.DetectedUtc).Take(5).Select((a, i) => new AnomalyRow(i, a)).ToList())
                : Task.FromResult<List<AnomalyRow>?>(null);
            _summary = await summary;
            _statusRows = Enum.GetValues<JobStatus>()
                .Select(st => new CountRow(st.ToString(), Fmt.Status(st), _summary.JobsByStatus.GetValueOrDefault(st.ToString()), st)).ToList();
            _pendingRows = _summary.PendingByType.OrderByDescending(p => p.Value).Select(p => new CountRow(p.Key, p.Key, p.Value)).ToList();
            _queues = await queues;
            _anomalies = await anomalies;
            Status.Set(L["Dashboard.Updated", Fmt.Time(DateTimeOffset.Now)]);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = L["Common.NetworkError"];
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<TResult?> TryAsync<TResult>(Func<Task<TResult>> call) where TResult : class
    {
        try { return await call(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { return null; }
    }

    private async Task ChangeIntervalAsync(int seconds)
    {
        _refreshSeconds = seconds;
        await Settings.SetAsync(seconds);
        StartTimer();
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = null;
        if (_refreshSeconds <= 0) return;
        var timer = _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshSeconds));
        _ = TickAsync(timer);
    }

    private async Task TickAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
