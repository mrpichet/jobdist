@page "/workers/{WorkerId:guid}"
@attribute [Authorize]
@implements IDisposable
@* S08 Worker detail: machine, capabilities, status, held jobs, learned performance, risk. *@
<PageTitle>@Title</PageTitle>

<RequirePermission Permission="@AppPermissions.WorkerView">
    <LoadState Ready="@(_worker is not null)" NotFound="_notFound" NotFoundTitle="@L["Worker.NotFound"]" NotFoundHint="@L["Worker.NotFoundHint"]" Error="@_error" OnRetry="LoadAsync">
        <FormTemplate Title="@Title" Description="@L["Worker.Detail.Description"]" Breadcrumbs="Crumbs" Mode="FormMode.View" Model="_worker!" OnCancel="@(() => Nav.NavigateTo("workers"))">
            <StatusBadge><WorkerStatusBadge Status="_worker!.Status" /></StatusBadge>
            <HeaderActions>
                <AppButton Text="@L["Common.Refresh"]" Icon="refresh" OnClick="LoadAsync" />
                @if (_worker!.Status == WorkerStatus.Online)
                {
                    <AppButton Text="@L["Worker.Drain"]" Icon="pause" Permission="@AppPermissions.WorkerDrain" Href="@($"workers/{WorkerId}/drain")" />
                }
                @if (_worker.Status != WorkerStatus.Unregistered)
                {
                    <AppButton Text="@L["Worker.Unregister"]" Icon="trash" Variant="ButtonVariant.Danger" Permission="@AppPermissions.WorkerUnregister" Href="@($"workers/{WorkerId}/unregister")" />
                }
            </HeaderActions>
            <ChildContent>
                <FormSection Title="@L["Worker.Detail.Section.Status"]">
                    <WorkerFacts Worker="_worker" Full="true" />
                </FormSection>

                <FormSection Title="@L["Worker.Detail.Section.Machine"]">
                    <FieldGrid Columns="2">
                        <FactField Label="@L["Worker.CpuCores"]" Value="@_worker!.Spec.CpuCores.ToString()" />
                        <FactField Label="@L["Worker.MemoryMb"]" Value="@($"{_worker.Spec.MemoryMb:N0} MB")" />
                        <FactField Label="@L["Worker.Gpu"]" Value="@_worker.Spec.GpuCount.ToString()" />
                        <FactField Label="@L["Worker.Benchmark"]" Value="@_worker.Spec.BenchmarkScore.ToString("N2")" />
                        <FactField Label="@L["Worker.Os"]" Value="@_worker.Spec.Os" />
                        <FactField Label="@L["Worker.Version"]" Value="@_worker.Version" />
                        <FactField Label="@L["Worker.Pqc"]" Value="@(_worker.SupportsPqc ? L["Common.Yes"].Value : L["Common.No"].Value)" />
                        <FactField Label="@L["Worker.Tags"]" Value="@string.Join(", ", _worker.Tags)" />
                        <FactField Label="@L["Worker.Registered"]" Value="@Fmt.Time(_worker.RegisteredUtc)" />
                    </FieldGrid>
                </FormSection>

                <FormSection Title="@L["Worker.Detail.Section.Capabilities"]">
                    <AppGrid TItem="CapabilityRow" Items="_capabilities" KeyFieldName="@nameof(CapabilityRow.JobType)" Caption="@L["Worker.Detail.Section.Capabilities"]" ShowGroupPanel="false">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(CapabilityRow.JobType)" Caption="@L["Job.JobType"]" SortIndex="0" SortOrder="GridColumnSortOrder.Ascending" />
                            <DxGridDataColumn FieldName="@nameof(CapabilityRow.MaxConcurrency)" Caption="@L["Worker.MaxConcurrency"]" DisplayFormat="N0" Width="160px" />
                            <DxGridDataColumn FieldName="@nameof(CapabilityRow.SpeedFactor)" Caption="@L["Worker.SpeedFactor"]" DisplayFormat="N2" Width="140px" />
                        </Columns>
                    </AppGrid>
                </FormSection>

                <FormSection Title="@L["Worker.Detail.Section.Jobs"]" Description="@L["Worker.Detail.JobsHint"]">
                    @if (_jobs is null)
                    {
                        <p class="muted">@L["Worker.Detail.JobsUnavailable"]</p>
                    }
                    else if (_jobs.Count == 0)
                    {
                        <p class="muted">@L["Worker.Detail.NoJobs"]</p>
                    }
                    else
                    {
                        <AppGrid TItem="JobRow" Items="_jobs" KeyFieldName="@nameof(JobRow.JobId)" Caption="@L["Worker.Detail.Section.Jobs"]" ShowGroupPanel="false">
                            <Columns><JobGridColumns /></Columns>
                            <RowActions Context="row">
                                <AppButton Text="@T["Common.View"]" Icon="eye" Size="ButtonSize.Small" Href="@($"jobs/{row.JobId}")" />
                            </RowActions>
                        </AppGrid>
                    }
                </FormSection>

                <PermissionView Permission="@AppPermissions.InsightView">
                    <FormSection Title="@L["Worker.Detail.Section.Performance"]">
                        @if (_performance is not { Count: > 0 })
                        {
                            <p class="muted">@L["Performance.None"]</p>
                        }
                        else
                        {
                            <AppGrid TItem="PerformanceRow" Items="_performance" KeyFieldName="@nameof(PerformanceRow.Key)" Caption="@L["Worker.Detail.Section.Performance"]" ShowGroupPanel="false">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.JobType)" Caption="@L["Job.JobType"]" />
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.Samples)" Caption="@L["Performance.Samples"]" DisplayFormat="N0" Width="110px" />
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.Successes)" Caption="@L["Performance.Successes"]" DisplayFormat="N0" Width="110px" />
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.Failures)" Caption="@L["Performance.Failures"]" DisplayFormat="N0" Width="110px" />
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.MeanMs)" Caption="@L["Performance.MeanMs"]" DisplayFormat="N0" Width="130px" />
                                    <DxGridDataColumn FieldName="@nameof(PerformanceRow.StdDevMs)" Caption="@L["Performance.StdDev"]" DisplayFormat="N0" Width="130px" />
                                </Columns>
                            </AppGrid>
                        }
                    </FormSection>
                </PermissionView>

                <FormSection Title="@L["Worker.Detail.Section.Risk"]">
                    <RiskView Risk="_risk" Error="@_riskError" />
                </FormSection>
            </ChildContent>
        </FormTemplate>
    </LoadState>
</RequirePermission>

@code {
    [Parameter] public Guid WorkerId { get; set; }

    [Inject] private JobDistApi Api { get; set; } = default!;
    [Inject] private PermissionService Permissions { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private readonly CancellationTokenSource _cts = new();
    private WorkerResponse? _worker;
    private List<JobRow>? _jobs;
    private List<PerformanceRow>? _performance;
    private List<CapabilityRow> _capabilities = [];
    private RiskAssessment? _risk;
    private string? _riskError;
    private bool _notFound;
    private string? _error;

    private string Title => _worker is null ? L["Worker.Detail.TitleLoading"] : L["Worker.Detail.Title", _worker.Name];
    private IReadOnlyList<Breadcrumb> Crumbs => [new(L["Menu.Dashboard"], ""), new(L["Menu.Workers"], "workers"), new(Title)];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var r = await Loaded<WorkerResponse>.FromAsync(() => Api.GetWorkerAsync(WorkerId, _cts.Token));
        (_worker, _notFound, _error) = (r.Value, r.NotFound, r.Error);
        if (_worker is null) return;
        _capabilities = _worker.Capabilities.Select(c => new CapabilityRow(c)).ToList();

        var jobs = Safe(async () => (await Api.ListJobsAsync(null, null, WorkerId, 0, 200, _cts.Token)).Items.Where(j => !Fmt.IsFinal(j.Status)).Select(j => new JobRow(j, _worker.Name)).ToList());
        var perf = await Permissions.HasPermissionAsync(AppPermissions.InsightView)
            ? Safe(async () => (await Api.GetPerformanceAsync(null, _cts.Token)).Where(p => p.WorkerId == WorkerId).OrderBy(p => p.JobType, StringComparer.Ordinal).Select(p => new PerformanceRow(p, _worker.Name)).ToList())
            : Task.FromResult<List<PerformanceRow>?>(null);
        try
        {
            _risk = await Api.GetWorkerRiskAsync(WorkerId, _cts.Token);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _riskError = ex is ApiException a ? a.Message : L["Common.NetworkError"];
        }
        _jobs = await jobs;
        _performance = await perf;
    }

    private static async Task<TResult?> Safe<TResult>(Func<Task<TResult>> call) where TResult : class
    {
        try { return await call(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { return null; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
