@* Read-only key facts of a job (used by S04-S06). *@
<dl class="kv">
    <dt>@L["Job.Id"]</dt><dd class="mono">@Job.JobId</dd>
    <dt>@L["Job.JobType"]</dt><dd>@Job.JobType</dd>
    <dt>@L["Job.Status"]</dt><dd><JobStatusBadge Status="Job.Status" /></dd>
    <dt>@L["Job.Priority"]</dt><dd>@Job.Priority</dd>
    <dt>@L["Job.Attempt"]</dt><dd>@Job.Attempt / @Job.MaxAttempts</dd>
    <dt>@L["Job.Worker"]</dt><dd>@(WorkerName ?? Fmt.Short(Job.AssignedWorkerId))</dd>
    <dt>@L["Job.Created"]</dt><dd>@Fmt.Time(Job.CreatedUtc)</dd>
    @if (Full)
    {
        <dt>@L["Job.RunAt"]</dt><dd>@Fmt.Time(Job.RunAtUtc)</dd>
        <dt>@L["Job.Started"]</dt><dd>@Fmt.Time(Job.StartedUtc)</dd>
        <dt>@L["Job.Completed"]</dt><dd>@Fmt.Time(Job.CompletedUtc)</dd>
        <dt>@L["Job.Duration"]</dt><dd>@Fmt.Duration(Job.LastDurationMs)</dd>
        @if (Job.CancelReason is not null)
        {
            <dt>@L["Job.CancelReason"]</dt><dd>@Job.CancelReason</dd>
        }
    }
</dl>

@code {
    [Parameter, EditorRequired] public JobStatusResponse Job { get; set; } = default!;
    [Parameter] public string? WorkerName { get; set; }
    [Parameter] public bool Full { get; set; }
}
