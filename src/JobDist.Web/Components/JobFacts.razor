@* Read-only key facts of a job (used by S04-S06), in the webcommon View-mode field layout. *@
<FieldGrid Columns="2">
    <FactField Label="@L["Job.Id"]" Value="@Job.JobId.ToString()" />
    <FactField Label="@L["Job.JobType"]" Value="@Job.JobType" />
    <FactField Label="@L["Job.Status"]" Value="@Fmt.Status(Job.Status)" />
    <FactField Label="@L["Job.Priority"]" Value="@Job.Priority.ToString()" />
    <FactField Label="@L["Job.Attempt"]" Value="@($"{Job.Attempt} / {Job.MaxAttempts}")" />
    <FactField Label="@L["Job.Worker"]" Value="@(WorkerName ?? Fmt.Short(Job.AssignedWorkerId))" />
    <FactField Label="@L["Job.Created"]" Value="@Fmt.Time(Job.CreatedUtc)" />
    @if (Full)
    {
        <FactField Label="@L["Job.RunAt"]" Value="@Fmt.Time(Job.RunAtUtc)" />
        <FactField Label="@L["Job.Started"]" Value="@Fmt.Time(Job.StartedUtc)" />
        <FactField Label="@L["Job.Completed"]" Value="@Fmt.Time(Job.CompletedUtc)" />
        <FactField Label="@L["Job.Duration"]" Value="@Fmt.Duration(Job.LastDurationMs)" />
        @if (Job.CancelReason is not null)
        {
            <FactField Label="@L["Job.CancelReason"]" Value="@Job.CancelReason" Full="true" />
        }
    }
</FieldGrid>

@code {
    [Parameter, EditorRequired] public JobStatusResponse Job { get; set; } = default!;
    [Parameter] public string? WorkerName { get; set; }
    [Parameter] public bool Full { get; set; }
}
