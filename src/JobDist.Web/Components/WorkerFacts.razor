@* Read-only key facts of a worker (S08-S10), in the webcommon View-mode field layout. *@
<FieldGrid Columns="2">
    <FactField Label="@L["Worker.Name"]" Value="@Worker.Name" />
    <FactField Label="@L["Worker.Id"]" Value="@Worker.WorkerId.ToString()" />
    <FactField Label="@L["Worker.Status"]" Value="@Fmt.Status(Worker.Status)" />
    <FactField Label="@L["Worker.Load"]" Value="@($"{Worker.ActiveJobs} / {Worker.MaxTotalConcurrency}")" />
    <FactField Label="@L["Worker.LastHeartbeat"]" Value="@Fmt.Time(Worker.LastHeartbeatUtc)" />
    @if (Full)
    {
        <FactField Label="@L["Worker.Cpu"]" Value="@Fmt.Percent(Worker.CpuUsagePercent)" />
        <FactField Label="@L["Worker.Memory"]" Value="@Fmt.Percent(Worker.MemoryUsagePercent)" />
        <FactField Label="@L["Worker.OfflineCount"]" Value="@Worker.OfflineCount.ToString()" />
    }
</FieldGrid>

@code {
    [Parameter, EditorRequired] public WorkerResponse Worker { get; set; } = default!;
    [Parameter] public bool Full { get; set; }
}
