@* Risk assessment: score, level, factors and recommendation. *@
@if (Risk is { } r)
{
    <div class="page-stack">
        <div class="toolbar-inline">
            <Badge Text="@L["Risk.LevelScore", L[$"Risk.Level.{r.Level}"].Value, r.Score.ToString("N0")]" Level="@Fmt.RiskLevel(r.Level)" Icon="shield" />
            <span>@r.Recommendation</span>
        </div>
        @if (r.Factors.Count > 0)
        {
            <AppGrid TItem="RiskFactorRow" Items="_factors" KeyFieldName="@nameof(RiskFactorRow.Index)"
                     Caption="@L["Risk.Factor"]" ShowSearchBox="false" ShowGroupPanel="false">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(RiskFactorRow.Name)" Caption="@L["Risk.Factor"]" Width="200px" />
                    <DxGridDataColumn FieldName="@nameof(RiskFactorRow.Points)" Caption="@L["Risk.Points"]" DisplayFormat="N1" Width="100px" />
                    <DxGridDataColumn FieldName="@nameof(RiskFactorRow.Explanation)" Caption="@L["Risk.Explanation"]" MinWidth="200" />
                </Columns>
            </AppGrid>
        }
        else
        {
            <p class="muted">@L["Risk.NoFactors"]</p>
        }
    </div>
}
else if (Error is not null)
{
    <Alert Level="AlertLevel.Warning">@Error</Alert>
}
else
{
    <LoadingState />
}

@code {
    [Parameter] public RiskAssessment? Risk { get; set; }
    [Parameter] public string? Error { get; set; }

    private RiskAssessment? _shown;
    private List<RiskFactorRow> _factors = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_shown, Risk)) return;
        _shown = Risk;
        _factors = Risk?.Factors.Select((f, i) => new RiskFactorRow(i, f)).ToList() ?? [];
    }
}
