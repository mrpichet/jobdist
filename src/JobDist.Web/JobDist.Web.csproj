<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    JobDist.Web: Blazor WebAssembly web console built on the mrpichet/webcommon templates (git submodule external/webcommon).
    Hosted by JobDist.Server (same origin, strict CSP). Signs in with AuthServer (client jobdist-web) and calls /api/* with a Bearer token.
    DevExpress licensing: put your DevExpress license key in %AppData%/DevExpress/DevExpress_License.txt (Windows),
    ~/.config/DevExpress/DevExpress_License.txt (Linux/macOS) or the DevExpress_License environment variable before building.
  -->
  <PropertyGroup>
    <RootNamespace>JobDist.Web</RootNamespace>
    <!-- No inline importmap, so the CSP can stay script-src 'self'. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <!-- Thai and English formatting regardless of the browser language. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\external\webcommon\src\WebCommon.UI\WebCommon.UI.csproj" />
    <ProjectReference Include="..\JobDist.Contracts\JobDist.Contracts.csproj" />
  </ItemGroup>
</Project>
