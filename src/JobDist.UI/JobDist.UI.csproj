<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    JobDist.UI: Blazor WebAssembly operator console built with DevExpress Blazor 26.1 components.
    Hosted by JobDist.Server (same origin, strict CSP). Talks only to the REST API with the operator's API key.
    DevExpress licensing: put your DevExpress license key in %AppData%/DevExpress/DevExpress_License.txt (Windows),
    ~/.config/DevExpress/DevExpress_License.txt (Linux/macOS) or the DevExpress_License environment variable before building.
  -->
  <PropertyGroup>
    <RootNamespace>JobDist.UI</RootNamespace>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- XML docs are not useful for Razor components. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="DevExpress.Blazor" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JobDist.Contracts\JobDist.Contracts.csproj" />
  </ItemGroup>
</Project>
