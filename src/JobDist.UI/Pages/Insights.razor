@page "/insights"
@inject JobDistApi Api

<h1>Anomalies &amp; learned performance</h1>
<div class="jd-toolbar">
    <span>Window (minutes)</span>
    <DxSpinEdit @bind-Value="_window" MinValue="5" MaxValue="1440" Width="110px" />
    <DxButton Text="Scan now" Click="LoadAsync" RenderStyle="ButtonRenderStyle.Primary" />
</div>
@if (_error is not null) { <div class="jd-error">@_error</div> }

<h2>Anomalies</h2>
<DxGrid Data="@_anomalies" PageSize="10">
    <Columns>
        <DxGridDataColumn FieldName="Severity" Width="100px" />
        <DxGridDataColumn FieldName="Kind" Width="180px" />
        <DxGridDataColumn FieldName="Subject" Width="200px" />
        <DxGridDataColumn FieldName="Description" />
    </Columns>
</DxGrid>

<h2>What the ML model learned</h2>
<DxGrid Data="@_performance" PageSize="20" ShowGroupPanel="true">
    <Columns>
        <DxGridDataColumn FieldName="JobType" GroupIndex="0" />
        <DxGridDataColumn FieldName="WorkerId" Caption="Worker" />
        <DxGridDataColumn FieldName="Samples" Width="90px" />
        <DxGridDataColumn FieldName="Successes" Width="90px" />
        <DxGridDataColumn FieldName="Failures" Width="90px" />
        <DxGridDataColumn FieldName="MeanDurationMs" Caption="Mean ms" DisplayFormat="N0" />
        <DxGridDataColumn FieldName="StdDevDurationMs" Caption="Std dev ms" DisplayFormat="N0" />
    </Columns>
</DxGrid>

@code {
    private int _window = 15;
    private List<Anomaly> _anomalies = [];
    private List<PerformanceStat> _performance = [];
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _anomalies = (await Api.GetAnomaliesAsync(_window))?.Anomalies ?? [];
            _performance = await Api.GetPerformanceAsync() ?? [];
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
