{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "LogServer": {
      "Enabled": false,
      "ServerUrls": "",
      "ApiKeyEnvironmentVariable": "LOGSERVER_API_KEY",
      "Source": "jobdist",
      "MinimumLevel": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30
  },
  "JobDist": {
    "DefaultMaxAttempts": 3,
    "DefaultTimeoutSeconds": 300,
    "HeartbeatIntervalSeconds": 5,
    "OfflineAfterSeconds": 20,
    "AssignmentStartTimeoutSeconds": 60,
    "LeaseGraceSeconds": 30,
    "RetryBaseDelaySeconds": 2,
    "RetryMaxDelaySeconds": 300,
    "CountWorkerLossAsAttempt": true,
    "SchedulerBatchSize": 2000,
    "SchedulerIdleDelayMs": 250,
    "AgingPointsPerMinute": 1.0,
    "UseSimd": true,
    "ParallelThreshold": 4,
    "LeaderLeaseSeconds": 15,
    "RetentionDays": 30,
    "Weights": {
      "Load": 0.35,
      "Speed": 0.35,
      "Reliability": 0.25,
      "Exploration": 0.05,
      "PreferredWorkerBonus": 0.5,
      "LastFailedPenalty": 0.3
    },
    "MinWorkerSdkVersion": null
  },
  "Anomaly": {
    "ScanIntervalMinutes": 1,
    "WindowMinutes": 15,
    "BaselineHours": 24,
    "ZScoreThreshold": 3.0,
    "FailureRateThreshold": 0.3,
    "MinSamples": 10,
    "FlappingThreshold": 3,
    "FailoverStormThreshold": 20,
    "AlertCooldownMinutes": 30,
    "MinAlertSeverity": "Warning"
  },
  "Alerts": {
    "OutboxBatchSize": 50,
    "OutboxPollSeconds": 2,
    "OutboxLockSeconds": 60,
    "MaxAttempts": 10,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelaySeconds": 900,
    "CircuitOpenDelaySeconds": 30,
    "RetentionDays": 90,
    "QueueCheckSeconds": 15,
    "QueueAlertCooldownMinutes": 30,
    "PendingCacheMilliseconds": 2000,
    "MessageHub": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiKey": "",
      "Sign": true,
      "AllowInsecureHttp": false,
      "TimeoutSeconds": 10,
      "ApiBasePath": "api"
    }
  },
  "Messaging": {
    "Transport": "Database",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "jobdist",
      "Password": "",
      "UseTls": false,
      "Exchange": "jobdist.alerts",
      "Queue": "jobdist.alerts",
      "DeadLetterExchange": "jobdist.alerts.dlx",
      "PrefetchCount": 20,
      "RelayLockSeconds": 300,
      "DeliveryLimit": 5
    }
  },
  "Crypto": {
    "KeyId": "jobdist"
  },
  "Mcp": {
    "AllowSideEffects": false,
    "AgentClientName": "mcp-agent"
  },
  "AgentChat": {
    "Enabled": false,
    "Provider": "",
    "Endpoint": "",
    "Model": "",
    "ApiKey": "",
    "MaxHistory": 20,
    "TimeoutSeconds": 60
  },
  "ClientLogging": {
    "Enabled": true,
    "MinimumLevel": "Warning"
  },
  "AuthServer": {
    "Authority": "",
    "Audience": "authserver-api",
    "RequireHttpsMetadata": true,
    "AdminRole": "admin"
  },
  "Security": {
    "ApiKeys": [],
    "AllowedOrigins": [],
    "HttpsRedirection": false
  }
}
