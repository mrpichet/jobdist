{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30
  },
  "JobDist": {
    "DefaultMaxAttempts": 3,
    "DefaultTimeoutSeconds": 300,
    "HeartbeatIntervalSeconds": 5,
    "OfflineAfterSeconds": 20,
    "AssignmentStartTimeoutSeconds": 60,
    "LeaseGraceSeconds": 30,
    "RetryBaseDelaySeconds": 2,
    "RetryMaxDelaySeconds": 300,
    "CountWorkerLossAsAttempt": true,
    "SchedulerBatchSize": 2000,
    "SchedulerIdleDelayMs": 250,
    "AgingPointsPerMinute": 1.0,
    "UseSimd": true,
    "ParallelThreshold": 4,
    "LeaderLeaseSeconds": 15,
    "RetentionDays": 30,
    "Weights": { "Load": 0.35, "Speed": 0.35, "Reliability": 0.25, "Exploration": 0.05, "PreferredWorkerBonus": 0.5, "LastFailedPenalty": 0.3 }
  },
  "Anomaly": {
    "ScanIntervalMinutes": 1,
    "WindowMinutes": 15,
    "BaselineHours": 24,
    "ZScoreThreshold": 3.0,
    "FailureRateThreshold": 0.3,
    "MinSamples": 10,
    "FlappingThreshold": 3,
    "FailoverStormThreshold": 20,
    "AlertCooldownMinutes": 30,
    "MinAlertSeverity": "Warning"
  },
  "Alerts": {
    "MessageHub": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiKey": "",
      "Channel": "Email",
      "Recipients": [],
      "Sign": true
    }
  },
  "Crypto": { "KeyId": "jobdist" },
  "Mcp": { "AllowSideEffects": false, "AgentClientName": "mcp-agent" },
  "Security": { "ApiKeys": [], "AllowedOrigins": [], "HttpsRedirection": false }
}
