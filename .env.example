# Copy to .env and replace every value. NEVER commit .env.

# ---- Database (PostgreSQL by default; see docker-compose.sqlserver.yml for SQL Server) ----
POSTGRES_PASSWORD=Change_Me_Str0ng!
# SQL Server 'sa' password (min 8 chars, upper+lower+digit+symbol) - only with docker-compose.sqlserver.yml
MSSQL_SA_PASSWORD=Change_Me_Str0ng!

# ---- Keys shared by ALL server instances (HA) ----
# AES-256 key for sensitive payloads at rest:            openssl rand -base64 32
PAYLOAD_PROTECTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Hybrid signing keys (ML-DSA-65 seed + ECDSA P-384):
#   openssl rand -base64 32
#   openssl ecparam -name secp384r1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
CRYPTO_KEY_ID=jobdist-prod
MLDSA_PRIVATE_SEED=REPLACE_WITH_BASE64_32_BYTES
ECDSA_PRIVATE_KEY_PKCS8=REPLACE_WITH_BASE64_PKCS8

# ---- API keys: the server stores only SHA-256 hex. Generate a key:  openssl rand -base64 32
#      and its hash:  printf '%s' 'the-key' | sha256sum
ADMIN_API_KEY_SHA256=REPLACE_WITH_SHA256_HEX
SUBMITTER_API_KEY_SHA256=REPLACE_WITH_SHA256_HEX
WORKER_API_KEY_SHA256=REPLACE_WITH_SHA256_HEX
AI_AGENT_API_KEY_SHA256=
VIEWER_API_KEY_SHA256=
# Plain worker key, used by the worker containers (its SHA-256 must equal WORKER_API_KEY_SHA256)
WORKER_API_KEY=REPLACE_WITH_WORKER_KEY
WORKER_REPLICAS=2

# AI agents may submit / cancel / re-prioritise jobs through MCP only when true
MCP_ALLOW_SIDE_EFFECTS=false

# ---- Admin alerts through mrpichet/messagehub (POST {MESSAGEHUB_URL}/api/messages, header X-Api-Key) ----
MESSAGEHUB_ENABLED=false
MESSAGEHUB_URL=https://messagehub.example.com
MESSAGEHUB_API_KEY=
MESSAGEHUB_CHANNEL=Email
ADMIN_ALERT_RECIPIENT=admin@example.com

# ---- OTLP key shared between services and the Aspire dashboard:  openssl rand -hex 24
OTLP_API_KEY=REPLACE_WITH_RANDOM_HEX

# ---- DevExpress license key file for the UI build (optional; without it the UI shows a trial banner)
DEVEXPRESS_LICENSE_FILE=./docker/empty-license.txt
