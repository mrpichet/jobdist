<Project>
  <!-- Central package management: every package version lives here only. -->
  <PropertyGroup>
    <!-- external/webcommon (git submodule) pins package versions in its own .csproj, so CPM is off for projects in that folder only.
         external/common has its own Directory.Packages.props, which MSBuild finds first. -->
    <ManagePackageVersionsCentrally Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/external/webcommon/'))">true</ManagePackageVersionsCentrally>
    <!-- webcommon treats warnings as errors. Without a DevExpress license key on the build machine DevExpress reports DX1000/DX1001:
         keep them visible as warnings but do not fail the jobdist build (install the key to remove them, see docs/INSTALLATION.md). -->
    <WarningsNotAsErrors Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/external/webcommon/'))">$(WarningsNotAsErrors);DX1000;DX1001</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft AI / MCP (official Microsoft + MCP C# SDK maintained with Microsoft) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Data access: Dapper (explicitly requested) + SQL Server (Microsoft) + PostgreSQL (Npgsql) -->
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <!-- Microsoft extensions -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <!-- Alert transport option Messaging:Transport=RabbitMq (official RabbitMQ .NET client) -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
    <!-- API versioning (same library as AuthServer) and same-origin reverse proxy to AuthServer (Microsoft YARP) -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Blazor WebAssembly UI -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageVersion Include="DevExpress.Blazor" Version="26.1.6" />
    <!-- OpenTelemetry (required by .NET Aspire dashboard / OTLP export) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- Tests -->
    <PackageVersion Include="MSTest" Version="4.5.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>
</Project>
